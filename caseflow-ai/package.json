  "dependencies": {
    "@google/genai": "^2.27.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "speakeasy": "^2.0.0",
    "sqlite3": "^6.0.1"
  }
