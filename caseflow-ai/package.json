{
  "name": "caseflow-ai",
  "version": "3.0.0",
  "description": "Nền tảng thẩm định hồ sơ sinh viên thông minh kết hợp AI Multimodal OCR (Gemini), Rule Engine, SQLite và Quy trình Ký số điện tử.",
  "main": "backend/server.py",
  "scripts": {
    "start": "python backend/server.py",
    "dev:backend": "python backend/server.py",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm install && npm run build",
    "test": "node test/run_security_suite.js",
    "test:security": "node test/run_security_suite.js"
  },
  "keywords": ["caseflow", "ai", "gemini", "ocr", "jwt", "totp", "sqlite"],
