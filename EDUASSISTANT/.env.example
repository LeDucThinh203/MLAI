# ==============================================================================
# CASEFLOW AI - UNIFIED ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Sao chép tệp này thành .env và điền các giá trị bảo mật trước khi triển khai
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SERVERS CONFIGURATION
# ------------------------------------------------------------------------------
APP_ENV=development
NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
PORT=3001
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001/api

# Browser authentication. Production cross-site frontend/API deployments need
# COOKIE_SECURE=true and COOKIE_SAMESITE=none. Leave the domain unset for a
# host-only cookie, or set it to a shared parent domain when appropriate.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.edu

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (JWT, REFRESH TOKEN, 2FA, SIGNATURE)
# ------------------------------------------------------------------------------
# Khóa bí mật ký JWT (Bắt buộc tối thiểu 32 ký tự ngẫu nhiên trong môi trường Production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_2026

# Khóa bí mật ký Refresh Token
REFRESH_SECRET=your_super_secret_refresh_token_key_at_least_32_characters_2026

# Khóa bí mật chữ ký số HMAC-SHA256 cấp chứng nhận học vụ
SIGNATURE_KEY=your_super_secret_digital_signature_hmac_key_2026

# ------------------------------------------------------------------------------
# 3. AI ENGINE (GOOGLE GEMINI VLM & OCR)
# ------------------------------------------------------------------------------
# Chế độ hoạt động của động cơ AI: live | mock | cache
AI_MODE=mock

# Khóa API Google Gemini AI (Chỉ bắt buộc nếu AI_MODE=live)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_VLM_MODEL=gemini-3.8-flash

# Provider dự phòng khi Gemini lỗi; dùng router chỉ chọn model miễn phí.
# Tạo khóa tại OpenRouter rồi khai báo biến này trong Render Environment.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ------------------------------------------------------------------------------
# 4. STORAGE & EVIDENCE FILES
# ------------------------------------------------------------------------------
DATA_DIR=
EVIDENCE_STORAGE_PATH=storage/evidence
MAX_UPLOAD_MB=20

# ------------------------------------------------------------------------------
# 5. DATABASE CONFIGURATION (POSTGRESQL)
# ------------------------------------------------------------------------------
DB_TYPE=postgresql
# Use the Render PostgreSQL External Database URL locally. Keep real credentials in .env or Render env vars; never commit them.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ------------------------------------------------------------------------------
# 6. REDIS (optional but recommended for distributed login rate limiting)
# ------------------------------------------------------------------------------
# Redis Cloud/Render connection string. Leave empty to use local-memory fallback.
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=eduassistant

