# ==============================================================================
# EDUASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Sao chép tệp này thành .env và điền các giá trị bảo mật trước khi triển khai
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SERVERS CONFIGURATION
# ------------------------------------------------------------------------------
APP_ENV=development
NODE_ENV=development
# Demo accounts/data are for local or demo environments only; production must set false.
SEED_DEMO_DATA=true
APP_HOST=0.0.0.0
APP_PORT=8000
PORT=3001
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001/api

# Browser authentication. Production cross-site frontend/API deployments need
# COOKIE_SECURE=true and COOKIE_SAMESITE=none. Leave the domain unset for a
# host-only cookie, or set it to a shared parent domain when appropriate.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.edu

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (JWT, REFRESH TOKEN, 2FA, SIGNATURE)
# ------------------------------------------------------------------------------
# Khóa bí mật ký JWT (Bắt buộc tối thiểu 32 ký tự ngẫu nhiên trong môi trường Production)
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters

# Khóa bí mật ký Refresh Token
REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters

# Shared HMAC-SHA256 key for internal record integrity checks; not a legal signature.
SIGNATURE_KEY=replace_with_a_random_hmac_key_at_least_32_characters

# ------------------------------------------------------------------------------
# 3. AI ENGINE (GOOGLE GEMINI VLM & OCR)
# ------------------------------------------------------------------------------
# Chế độ hoạt động của động cơ AI: live | mock | cache
AI_MODE=mock

# Khóa API Google Gemini AI (Chỉ bắt buộc nếu AI_MODE=live)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_VLM_MODEL=gemini-3.8-flash

# Provider dự phòng khi tất cả model Gemini lỗi. Hệ thống tự lấy danh sách
# model OpenRouter có giá đầu vào/đầu ra bằng 0 và lần lượt thử từng model.
OPENROUTER_API_KEY=

# Student AI Agent only (server-side providers; no credentials are exposed to the frontend)
AGENT_ENABLED=true
AGENT_MAX_TOOL_STEPS=4
AGENT_RAG_TOP_K=5
AGENT_HISTORY_MESSAGES=12
AGENT_ACTION_TTL_SECONDS=300
AGENT_MAX_MESSAGE_CHARS=6000
GEMINI_EMBEDDING_MODEL=

# ------------------------------------------------------------------------------
# 4. STORAGE & EVIDENCE FILES
# ------------------------------------------------------------------------------
DATA_DIR=
EVIDENCE_STORAGE_PATH=storage/evidence
MAX_UPLOAD_MB=20

# ------------------------------------------------------------------------------
# 5. DATABASE CONFIGURATION (POSTGRESQL)
# ------------------------------------------------------------------------------
DB_TYPE=postgresql
# Use a local PostgreSQL URL for development. Keep real credentials in .env or deployment environment variables; never commit them.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Internal demo records are not authoritative. Production must keep this false.
ALLOW_ADMIN_VERIFIED_DEMO_SIS=false

# ------------------------------------------------------------------------------
# 6. REDIS (optional but recommended for distributed login rate limiting)
# ------------------------------------------------------------------------------
# Redis Cloud/Render connection string. Leave empty to use local-memory fallback.
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=eduassistant

