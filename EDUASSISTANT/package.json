{
  "name": "eduassistant",
  "version": "3.0.0",
  "description": "EduAssistant - Nền tảng thẩm định hồ sơ sinh viên thông minh kết hợp AI Multimodal OCR (Gemini), Rule Engine, PostgreSQL và HMAC-SHA256 data integrity checks.",
  "main": "backend/target/eduassistant-backend.jar",
  "scripts": {
    "start": "mvnw -f backend/pom.xml spring-boot:run",
    "dev:backend": "mvnw -f backend/pom.xml spring-boot:run",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm install && npm run build"
  },
  "keywords": [
    "caseflow",
    "ai",
    "gemini",
    "ocr",
    "jwt",
    "totp",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.27.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  }
}
