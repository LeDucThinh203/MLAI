# ==============================================================================
# CASEFLOW AI - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Sao chép tệp này thành .env và điền các giá trị bảo mật trước khi triển khai
# ==============================================================================

NODE_ENV=production
PORT=3001

# Khóa bí mật ký JWT (Bắt buộc tối thiểu 32 ký tự ngẫu nhiên trong môi trường Production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_2026

# Khóa bí mật ký Refresh Token
REFRESH_SECRET=your_super_secret_refresh_token_key_at_least_32_characters_2026

# Khóa bí mật chữ ký số HMAC-SHA256 cấp chứng nhận học vụ
SIGNATURE_KEY=your_super_secret_digital_signature_hmac_key_2026

# Chế độ hoạt động của động cơ AI: live | mock | cache
AI_MODE=mock

# Khóa API Google Gemini AI (Chỉ bắt buộc nếu AI_MODE=live)
GEMINI_API_KEY=

# Thư mục lưu trữ cơ sở dữ liệu SQLite và tệp đính kèm bền vững (tùy chọn)
DATA_DIR=

# URL API kết nối từ Frontend (khi deploy Cloudflare / Vercel)
VITE_API_BASE_URL=http://localhost:3001/api
